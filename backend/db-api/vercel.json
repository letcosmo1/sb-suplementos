{
    "version": 2,
    "builds": [
      {
        "src": "./src/server.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/[^.]+",
        "dest": "/",
        "methods": ["GET", "POST", "PUT", "PATCH", "DELETE"],
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      }
    ],
    "rewrites":  [
        {"source": "/(.*)", "destination": "/"}
    ]
  }